# ==========================================
# Vessel Environment Configuration
# ==========================================

# 1. Relational Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://vessel_user:vessel_password@localhost:5432/vessel?schema=public"

# 2. Session & Auth Security
SESSION_SECRET="your_super_secret_jwt_key_min_32_chars"

# 3. AWS S3 / Object Storage (Source of truth for project code)
S3_BUCKET="vessel-storage"
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REGION="us-east-1"
S3_ENDPOINT="https://s3.amazonaws.com"

# 4. Docker Sandbox Execution
# Leave blank for default local pipe/socket, or specify e.g. unix:///var/run/docker.sock
DOCKER_HOST=""
RUNNER_IMAGE="rikkyj/runner:latest"

# 5. Runner WebSocket URL (Optional client override)
# NEXT_PUBLIC_RUNNER_WS_URL="http://localhost:3001"
